DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-this-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=alimma
POSTGRES_USER=alimma
POSTGRES_PASSWORD=changez-ce-mot-de-passe-local
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
# En production Neon, définissez impérativement POSTGRES_SSLMODE=require.
POSTGRES_SSLMODE=prefer
REDIS_URL=redis://127.0.0.1:6379/1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
FEATURE_2FA_ENABLED=false
# Sécurité API : le proxy n'est accepté que lorsqu'il est explicitement déclaré.
NUM_PROXIES=0
THROTTLE_ANON_RATE=120/minute
THROTTLE_USER_RATE=1000/day
THROTTLE_INSCRIPTION_RATE=5/hour
THROTTLE_LOGIN_RATE=10/minute
THROTTLE_OTP_RATE=3/hour
THROTTLE_PUBLICATION_RATE=20/day
THROTTLE_PUBLIC_RATE=120/minute
LOG_LEVEL=INFO
# Laisser SENTRY_DSN vide désactive Sentry. En production, DJANGO_ENV=production.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
DJANGO_ENV=development
# Stockage des médias : local en développement, s3 pour Cloudflare R2/AWS S3.
MEDIA_BACKEND=local
MEDIA_URL=/media/
MEDIA_ROOT=media
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_CUSTOM_DOMAIN=
AWS_QUERYSTRING_AUTH=False
PROFILE_PHOTO_MAX_SIZE=2097152
