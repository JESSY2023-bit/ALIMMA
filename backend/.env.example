DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-this-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=alimma
POSTGRES_USER=alimma
POSTGRES_PASSWORD=changez-ce-mot-de-passe-local
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
# En production Neon, définissez impérativement POSTGRES_SSLMODE=require.
POSTGRES_SSLMODE=prefer
REDIS_URL=redis://127.0.0.1:6379/1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
FEATURE_2FA_ENABLED=false
# Stockage local des photos de profil (remplaçable par un stockage Django externe).
MEDIA_URL=/media/
MEDIA_ROOT=media
PROFILE_PHOTO_MAX_SIZE=2097152
