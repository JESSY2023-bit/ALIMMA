# Nom de la base PostgreSQL utilisée par ALIMMA
POSTGRES_DB=alimma

# Utilisateur PostgreSQL
POSTGRES_USER=alimma

# Mot de passe PostgreSQL (à remplacer hors développement)
POSTGRES_PASSWORD=change_me

# Port PostgreSQL exposé sur l'hôte
POSTGRES_PORT=5433

# Port Redis exposé sur l'hôte
REDIS_PORT=6379

# Clé secrète Django (à générer pour chaque environnement)
SECRET_KEY=change_me_to_a_secure_secret_key

# Module de paramètres Django actif
DJANGO_SETTINGS_MODULE=config.settings.dev

# Hôtes Django autorisés, séparés par des virgules
ALLOWED_HOSTS=localhost,127.0.0.1

# Origines CORS autorisées, séparées par des virgules
CORS_ALLOWED_ORIGINS=http://localhost:5173

# URL de l'API consommée par Vite
VITE_API_URL=http://localhost:8000/api
