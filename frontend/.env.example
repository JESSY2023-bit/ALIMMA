
# URL de l'API Django pour le développement local.
VITE_API_URL=https://alimma.onrender.com/v1/

# En local, le navigateur appelle Vite, qui relaie /v1 vers Django.
VITE_API_URL=/v1

# Cible du proxy Vite : « backend » avec Docker Compose, localhost hors Docker.
VITE_API_PROXY_TARGET=http://backend:8000

